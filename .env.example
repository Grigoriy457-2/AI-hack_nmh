# Скопируйте в .env. Без ключей всё работает в mock-режиме (демо офлайн).

# --- БД ---
# Локально (по умолчанию):
DATABASE_URL=sqlite+aiosqlite:///./newsflow.db
# MySQL (docker compose задаёт сам):
# DATABASE_URL=mysql+aiomysql://newsflow:newsflow@localhost:3306/newsflow?charset=utf8mb4
SEED_ON_STARTUP=true

# --- Безопасность ---
SECRET_KEY=change-me
DEMO_PASSWORD=demo

# --- LLM (auto | anthropic | mock) ---
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Web search (mock | tavily) ---
SEARCH_PROVIDER=mock
TAVILY_API_KEY=

# --- MAX (auto | bot | mock) ---
MAX_PROVIDER=auto
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api.max.ru
MAX_POLL_INTERVAL=5
MAX_POLLER_ENABLED=true

# --- Пайплайн ---
CHAIN_MAX_ITERATIONS=3
PIPELINE_INLINE=false
STALE_AFTER_MINUTES=30

# --- Демо-поток (mock MAX): 10 сообщений сразу, далее по одному каждые 10–30 с ---
DEMO_STREAM_ENABLED=true
DEMO_STREAM_INITIAL=10
DEMO_STREAM_MIN_SEC=10
DEMO_STREAM_MAX_SEC=30
DEMO_STREAM_LOOP=false

# --- Реальное время ---
SSE_POLL_SEC=1.0
SSE_KEEPALIVE_SEC=15
EMERGING_WINDOW_MIN=240
EMERGING_MIN_MESSAGES=3

# --- Telegram (mock | telethon | bot | web | auto), см. docs/TELEGRAM.md ---
TG_ENABLED=true
TG_PROVIDER=mock
TG_SOURCES=
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=data/telegram/newsflow
TG_BOT_TOKEN=
TG_POLL_INTERVAL=20
